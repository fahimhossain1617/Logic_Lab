# ==========================================
# Logic Lab — Environment Variables Template
# ==========================================

# Required for Gemini AI trace generation & visual explanations:
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional Model override (default is gemini-2.5-flash / gemini-3.8-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Port for local dev server (default is 3000)
PORT=3000

# ==========================================
# Firebase Configuration (Vercel & Client)
# ==========================================
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
